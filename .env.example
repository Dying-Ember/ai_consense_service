# Copy to .env.local (ignored). Replace the host and obtain a separate relay token privately.
# Spring Boot does not load .env.local automatically; see docs/minimax-relay-handoff.md.
SPRING_PROFILES_ACTIVE=h2,minimax-relay
CONSENSE_MINIMAX_BASE_URL=http://RELAY_HOST:8092
CONSENSE_MINIMAX_RELAY_API_KEY=
CONSENSE_H2_JDBC_URL=jdbc:h2:file:./data/teammate-consense;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
CONSENSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONSENSE_LLM_ENABLED=false
CONSENSE_OCR_ENABLED=false

# Optional SDK aliases. Leave blank to reuse CONSENSE_* above in tools/minimax_relay/client.py.
# If set independently, OPENAI_BASE_URL must be http://RELAY_HOST:8092/v1.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=MiniMax-M3
